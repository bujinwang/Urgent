# ============================================================
# 急救侠 — 生产环境变量（docker-compose.prod.yml 使用）
# ============================================================
# 用途：本文件同时承担两种角色
#   1) compose 变量替换：${DOMAIN} / ${TLS_EMAIL}（Caddyfile 亦从环境变量读取）
#   2) server 运行时配置（通过 compose 的 env_file 注入容器）
#
# ⚠️ 生产环境的 **server 运行时变量**（含下方 `ALIYUN_*` / `TRUST_PROXY_HOPS` / 限流等）
#    必须写在本文件（仓库根 `.env`）：
#      `docker-compose.prod.yml` 的 `env_file` 只读**与本文件同目录**的 `./.env`；
#      **`急救侠-server/.env` 在生产部署下不会被读取**（它只服务本地裸跑后端）。
#    写错文件 ⇒ 变量静默缺失 ⇒ 短信/语音等「任一为空即关闭」的门控功能**零报错地永久失效**。
#
# 上机步骤：
#   cp .env.example .env
#   # 只需修改 DOMAIN / TLS_EMAIL / JWT_SECRET / GOV_JWT_SECRET / CORS_ORIGINS
#   openssl rand -hex 32   # 分别生成 JWT_SECRET 与 GOV_JWT_SECRET，务必两个不同
# ============================================================

# ---- 站点与 TLS ----
# 站点域名：A/AAAA 记录需指向部署主机（**必填**）
DOMAIN=your-domain.example
# ACME 账号邮箱：用于证书到期提醒。
# ⚠️ **不能留空**（空值会让 Caddyfile 的 `tls` 行解析失败，已实测）；
#    不想配置时请删除 Caddyfile 中的 `tls ...` 一行，自动 HTTPS 依然生效。
TLS_EMAIL=you@example.com

# ---- 后端运行时 ----
PORT=3001
# JWT 业务令牌签名密钥（生产必须为强随机，例：openssl rand -hex 32）
JWT_SECRET=please-generate-with-openssl-rand-hex-32
# 政府看板令牌独立密钥（P2-8）
# ⚠️ **必须与 JWT_SECRET 不同**：若两者相同，政府令牌可穿透业务鉴权链
#    （authMiddleware 虽另有 `gov:true` 声明拦截，但密钥相同会削弱隔离层）。
GOV_JWT_SECRET=please-generate-a-different-openssl-rand-hex-32
# 政府看板令牌有效期（时长字符串，默认 12h；如需更长会话可调，如 8h / 24h）
# GOV_TOKEN_TTL=12h
# SQLite 数据库路径（容器内路径，由 server-data 卷持久化）
DB_PATH=./data/jiujiaxia.db
# CORS 白名单（逗号分隔）。生产**务必配置**：未配置时后端会放开并告警。
CORS_ORIGINS=https://your-domain.example
# 反代信任跳数（TRUST_PROXY_HOPS，默认 2）：使 `req.ip` 反映真实客户端 IP（IP 限流依赖它）。
# ⚠️ 必须与**真实反代链路跳数一致**（生产：Caddy(443) → nginx(web:80) → server = 2 跳）。
#   设**过多** = 允许客户端伪造 `X-Forwarded-For` 绕过限流；设 `0` = 关闭（服务被直接暴露时用）。
#   切勿填 `true`。
# TRUST_PROXY_HOPS=2

# ---- 可选：微信小程序 ----
# 留空则走后端开发模式（模拟微信登录），生产接入时填写
# WECHAT_APPID=wx_your_appid
# WECHAT_SECRET=your_app_secret

# ---- 阿里云短信（AED 责任人联动「推送失败 → 即时短信降级」，P1）----
# 配置门控：以下 4 项**任一为空**即视为功能关闭（行为与未接入短信完全一致）。
# 需**企业实名**并在阿里云控制台完成**短信签名 + 模板报备**后才有真实值；模板变量需与
# `routes/aed.ts` 中传给 sendSms 的 templateParam（device / address）一致。
# ALIYUN_SMS_ACCESS_KEY_ID=
# ALIYUN_SMS_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_TEMPLATE_CODE=SMS_xxxxxxxx
# 短信服务地域（默认 cn-hangzhou）
# ALIYUN_SMS_REGION=cn-hangzhou

# ---- 阿里云语音降级（P1：短信状态报告「未送达」→ 语音呼叫责任人）----
# 配置门控：TTS 模板 + 上方 AK/SK 齐备才生效；缺失即降级为既有行为。
# 需报备**语音 TTS 模板**（`TTS_xxxxxxxx`）后方可使用。
# ALIYUN_VOICE_TTS_CODE=TTS_xxxxxxxx
# 主叫号（CalledShowNumber）——**可选**：
#   留空 = **公共模式**（系统从公共号码池调度，**无需购买号码**）；
#   填值 = **专属模式**（须与实际购买号码一致，且 TTS 模板的「外呼模式」必须匹配：公共模板↔公共模式，否则报错）。
# ALIYUN_VOICE_CALLER_NUMBER=0571xxxx5678

# 语音成本护栏：**全局每日**呼叫上限（默认 200）。达上限后当天不再呼叫（回调仍记录、返 200）。
# 名额按「发起次数」原子预留，呼叫失败不回收；可据此控制语音费用上限。
# ALIYUN_VOICE_DAILY_LIMIT=200

# 短信状态报告回调验真密钥（P1 语音降级）：
#   配置后 `POST /api/public/aliyun-sms-report` 生效（校验请求头 `x-sms-report-secret`，常量时间比较）；
#   **未配置时该端点返回 404**（不暴露端点存在）。
# ALIYUN_SMS_REPORT_SECRET=

# 短信状态报告回调端点的分钟限流（默认 60）
# SMS_REPORT_MINUTE_LIMIT=60

# ---- 反滥用护栏（P1）----
# notify-custodian：同请求者 × 同 AED 冷却期（毫秒，默认 120000；设为 0 关闭冷却）
# AED_NOTIFY_COOLDOWN_MS=120000
# notify-custodian：同请求者小时频次上限（默认 10）
# AED_NOTIFY_HOURLY_LIMIT=10
# 匿名端点按 IP 小时限流（默认：上传 10、咨询 5）
# MEDIA_UPLOAD_HOURLY_LIMIT=10
# INQUIRE_HOURLY_LIMIT=5
