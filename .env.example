# ============================================================
# 急救侠 — 生产环境变量（docker-compose.prod.yml 使用）
# ============================================================
# 用途：本文件同时承担两种角色
#   1) compose 变量替换：${DOMAIN} / ${TLS_EMAIL}（Caddyfile 亦从环境变量读取）
#   2) server 运行时配置（通过 compose 的 env_file 注入容器）
#
# 上机步骤：
#   cp .env.example .env
#   # 只需修改 DOMAIN / TLS_EMAIL / JWT_SECRET / GOV_JWT_SECRET / CORS_ORIGINS
#   openssl rand -hex 32   # 分别生成 JWT_SECRET 与 GOV_JWT_SECRET，务必两个不同
# ============================================================

# ---- 站点与 TLS ----
# 站点域名：A/AAAA 记录需指向部署主机（**必填**）
DOMAIN=your-domain.example
# ACME 账号邮箱：用于证书到期提醒。
# ⚠️ **不能留空**（空值会让 Caddyfile 的 `tls` 行解析失败，已实测）；
#    不想配置时请删除 Caddyfile 中的 `tls ...` 一行，自动 HTTPS 依然生效。
TLS_EMAIL=you@example.com

# ---- 后端运行时 ----
PORT=3001
# JWT 业务令牌签名密钥（生产必须为强随机，例：openssl rand -hex 32）
JWT_SECRET=please-generate-with-openssl-rand-hex-32
# 政府看板令牌独立密钥（P2-8）
# ⚠️ **必须与 JWT_SECRET 不同**：若两者相同，政府令牌可穿透业务鉴权链
#    （authMiddleware 虽另有 `gov:true` 声明拦截，但密钥相同会削弱隔离层）。
GOV_JWT_SECRET=please-generate-a-different-openssl-rand-hex-32
# SQLite 数据库路径（容器内路径，由 server-data 卷持久化）
DB_PATH=./data/jiujiaxia.db
# CORS 白名单（逗号分隔）。生产**务必配置**：未配置时后端会放开并告警。
CORS_ORIGINS=https://your-domain.example

# ---- 可选：微信小程序 ----
# 留空则走后端开发模式（模拟微信登录），生产接入时填写
# WECHAT_APPID=wx_your_appid
# WECHAT_SECRET=your_app_secret
