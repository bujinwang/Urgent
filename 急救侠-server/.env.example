# 急救侠 后端服务配置

# HTTP 服务端口
PORT=3001

# JWT 签名密钥（生产环境请更换为强随机字符串）
JWT_SECRET=jiujiaxia-dev-secret

# SQLite 数据库路径（默认 ./data/jiujiaxia.db，:memory: 为测试用）
DB_PATH=./data/jiujiaxia.db

# 政府看板令牌的独立签名密钥（P2-8）
# 未配置时：非生产环境生成进程级随机密钥；**生产环境必须显式配置**（否则启动即报错）。
# ⚠️ 必须与 JWT_SECRET 不同，否则政府令牌与业务令牌的隔离被削弱。
# 生成：openssl rand -hex 32
GOV_JWT_SECRET=

# CORS 允许来源白名单（逗号分隔）。未配置时开发放开；**生产建议显式配置**，否则启动会告警。
CORS_ORIGINS=

# 微信小程序 AppID 和 Secret（留空则使用开发模式模拟）
# WECHAT_APPID=wx_your_appid
# WECHAT_SECRET=your_app_secret

# ---- 阿里云短信（AED 责任人联动「推送失败 → 即时短信降级」，P1）----
# 配置门控：以下 4 项**任一为空**即视为功能关闭（行为与未接入短信完全一致）。
# 需**企业实名**并在阿里云控制台完成**短信签名 + 模板报备**后才有真实值；模板变量需与
# `routes/aed.ts` 中传给 sendSms 的 templateParam（device / address）一致。
# ALIYUN_SMS_ACCESS_KEY_ID=
# ALIYUN_SMS_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_TEMPLATE_CODE=SMS_xxxxxxxx
# 短信服务地域（默认 cn-hangzhou）
# ALIYUN_SMS_REGION=cn-hangzhou
