# pnpm
shamefully-hoist=true

# npm: 本项目依赖树存在未对齐的 peer 依赖 —— pinia@3.0.4 要求 peer vue@^3.5.11，
# 而 uni-app 侧锁定 vue@^3.4.21，npm 的严格 peer 校验会 ERESOLVE 失败。
# 本地 node_modules 由 pnpm 安装（peer 校验宽松）故一直未暴露，但 CI 的 `npm ci`
# 会直接失败。显式声明 legacy-peer-deps，使 npm 与 pnpm 的解析行为保持一致。
# TODO(技术债)：版本对齐后移除本行。2026-09 实测结论：
#   - uni-app `3.0.0-4080420251103001` 内部锁定 vue@3.4.21（`@vue/server-renderer@3.4.21` → vue 3.4.21 deduped）；
#     而 pinia@3 要求 peer vue@^3.5.11 → 直接升级 vue 会与 uni-app 的 vue 版本约束冲突（有破坏构建风险）。
#   - 另一路径：把 pinia 降回 2.x（peer 兼容 vue 3.4），属**主版本变更**，需单独评估 + 回归，不在本轮范围。
# 结论：本轮**保留** legacy-peer-deps（不强行改动导致 npm ci / 构建失败）。
legacy-peer-deps=true
