# pnpm
shamefully-hoist=true

# npm: 本项目依赖树存在未对齐的 peer 依赖 —— pinia@3.0.4 要求 peer vue@^3.5.11，
# 而 uni-app 侧锁定 vue@^3.4.21，npm 的严格 peer 校验会 ERESOLVE 失败。
# 本地 node_modules 由 pnpm 安装（peer 校验宽松）故一直未暴露，但 CI 的 `npm ci`
# 会直接失败。显式声明 legacy-peer-deps，使 npm 与 pnpm 的解析行为保持一致。
# TODO(技术债)：择机把 vue / pinia / @vitejs/plugin-vue 的版本对齐后移除本行。
legacy-peer-deps=true
