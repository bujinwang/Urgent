node_modules/
dist/
.DS_Store
*.local
# 例外：本机生产栈自测的 Caddy 配置（不含密钥，需入库以便换机复用）
!Caddyfile.local
# 本机自测导出的 Caddy 内部根证书（每台机器/每次重装都会变，不入库）
caddy-root.crt
.pnpm-store/

# 本地工作区数据（Agent 记忆 / 团队与任务状态），不入库
.workbuddy/

# SQLite WAL files (auto-generated)
*.db-shm
*.db-wal

# vitest 配置打包临时产物（进程被中断时会残留）
*.timestamp-*.mjs

# ★ 环境变量 / 密钥文件：绝不入库。
# 本仓库为 **PUBLIC**，这里任何一次 git add -A 都会把密钥公开给所有人。
# 生产栈 compose 引用的就是仓库根 `.env`（docker-compose.prod.yml），
# 而 server 侧另有自己的 .gitignore（已忽略 急救侠-server/.env）。
.env
.env.*
# 例外：样例模板必须入库 —— 部署接线要以它为清单（根与 server 各一份）
!.env.example
